# Kareebu Plus backend selection. Keep demo mode during local migration.
EXPO_PUBLIC_KAREEBU_BACKEND_MODE=demo
# EXPO_PUBLIC_KAREEBU_API_URL=http://10.0.2.2:8800
# EXPO_PUBLIC_LEGACY_6AM_API_URL=https://6ammart-admin.6amtech.com

# Kareebu+ v2.9 defaults to the free/open search + routing stack.
# No API key is required for local development with the public demo services.
EXPO_PUBLIC_MAPS_STACK=open
EXPO_PUBLIC_PHOTON_BASE_URL=https://photon.komoot.io
EXPO_PUBLIC_VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
EXPO_PUBLIC_VALHALLA_CLIENT_ID=kareebu-plus-dev

# The current React Native map display still uses react-native-maps.
# Keep your Android Maps SDK key here for Google map tiles in the existing dev build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_android_api_key

# Optional: switch search + routing back to Google with ONE app flag.
# EXPO_PUBLIC_MAPS_STACK=google
# EXPO_PUBLIC_PLACES_PROXY_URL=http://10.0.2.2:8787
#
# Start scripts/places-proxy.mjs with server-only keys:
# GOOGLE_PLACES_SERVER_API_KEY=...
# GOOGLE_ROUTES_SERVER_API_KEY=...
#
# Direct development keys are supported only as a temporary fallback. Do not ship these.
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_temporary_places_dev_key
# EXPO_PUBLIC_GOOGLE_ROUTES_API_KEY=your_temporary_routes_dev_key

# Optional Kareebu AI backend. Do NOT put a model/provider secret in the mobile app.
# The app POSTs { message, context } to: <base>/assistant
# If unset, Kareebu+ uses the built-in demo concierge so the UX is testable locally.
# EXPO_PUBLIC_KAREEBU_AI_URL=http://10.0.2.2:8790

# Kareebu AI (OpenAI-backed server running locally on your Mac)
# Android emulator reaches the Mac through 10.0.2.2.
EXPO_PUBLIC_KAREEBU_AI_URL=http://10.0.2.2:8790

# Server-only variables. Set these in the Terminal that runs server/kareebu-ai-api.mjs.
# NEVER prefix these with EXPO_PUBLIC_ and never put the secret in the React Native bundle.
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-5-mini
# KAREEBU_AI_RATE_LIMIT=30
