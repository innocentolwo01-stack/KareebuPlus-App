{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "authorized-donor-snapshot",
    "careem-donor-workspace",
    "careem-port-reports",
    ".careem-port-backups",
    ".kareebu-backups",
    "docs",
    "dist",
    "build"
  ]
}
